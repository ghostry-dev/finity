{
  "name": "@ghostry/finity-core",
  "version": "0.0.12",
  "license": "MIT",
  "description": "The framework-agnostic core of finity, for adapting it to another framework.",
  "keywords": [
    "finite state",
    "state management",
    "TypeScript",
    "frontend",
    "exhaustive",
    "switch",
    "transition"
  ],
  "author": {
    "name": "Patrick Rebsch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostry-dev/finity",
    "directory": "pkg/core"
  },
  "homepage": "https://docs.ghostry.dev/finity",
  "bugs": "https://github.com/ghostry-dev/finity/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "./dist/types/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:reset": "rm -rf ./dist",
    "build:compile": "bun --bun rslib build --config ../../rslib.shared.config.ts",
    "build:verify": "tsc --noEmit -p ./tsconfig.verify.json",
    "build:clean": "find ./dist -type f -name '*.tsbuildinfo' -delete",
    "build": "bun run build:reset && bun run build:compile && bun run build:verify && bun run build:clean",
    "outdated": "bun outdated"
  },
  "files": [
    "dist"
  ]
}
