{
  "name": "@ghostry/finity-solidjs",
  "version": "0.0.14",
  "license": "MIT",
  "description": "Finite state with exhaustive cases and enforced transitions, for Solid.",
  "keywords": [
    "finite state",
    "state management",
    "TypeScript",
    "frontend",
    "exhaustive",
    "switch",
    "transition"
  ],
  "author": {
    "name": "Patrick Rebsch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostry-dev/finity",
    "directory": "pkg/finity-solidjs"
  },
  "homepage": "https://docs.ghostry.dev/finity",
  "bugs": "https://github.com/ghostry-dev/finity/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "./dist/types/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:reset": "rm -rf ./dist",
    "build:compile": "bunx --no-install --bun rslib build --config ./rslib.config.ts",
    "build:compile:rsdoctor": "RSDOCTOR=true bunx --no-install --bun rslib build --config ./rslib.config.ts",
    "build:types": "bun --bun ../../node_modules/typescript-5/lib/tsc.js -p ./tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --declarationDir ./dist/types",
    "build:verify": "tsc --noEmit -p ./tsconfig.verify.json",
    "build:verify:solid1": "tsc --noEmit -p ./tsconfig.verify.solid1.json",
    "build:clean": "find ./dist -type f -name '*.tsbuildinfo' -delete",
    "build": "bun run build:reset && bun run build:compile && bun run build:types && bun run build:verify && bun run build:verify:solid1 && bun run build:clean",
    "build:rsdoctor": "bun run build:reset && bun run build:compile:rsdoctor && bun run build:types && bun run build:verify && bun run build:verify:solid1 && bun run build:clean",
    "typecheck": "tsc --noEmit",
    "typecheck:ts5": "bun --bun ../../node_modules/typescript-5/lib/tsc.js --noEmit",
    "typecheck:jsr": "DENO_BIN_PATH=$PWD/../../node_modules/.bin/deno bunx --no-install jsr publish --dry-run --allow-dirty",
    "format": "bun fmt",
    "test": "bun run typecheck && bun run typecheck:ts5 && bun run typecheck:jsr && bun run test:solid2 && bun run test:solid1",
    "test:solid2": "bun test --conditions browser --conditions development",
    "test:solid1": "FINITY_SOLID=1 bun test --conditions browser --conditions development"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ghostry/finity-core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-typescript": "^8.0.7",
    "@ghostry/harness": "^0.0.7",
    "@happy-dom/global-registrator": "^21.0.4",
    "@solidjs/compiler": "2.0.2",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/web": "^2.0.3",
    "babel-preset-solid": "^1.9.19",
    "solid-js": "^2.0.3",
    "solid-js-1": "npm:solid-js@^1.9.20",
    "solid-js-1-testing-library": "npm:@solidjs/testing-library@^0.8.10"
  }
}
